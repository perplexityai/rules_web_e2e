load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//playwright:defs.bzl", "playwright_runtime")

ts_project(
    name = "typecheck",
    srcs = glob([
        "*.ts",
        "fixtures/*.ts",
    ]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "declaration": True,
        "skipLibCheck": True,
        "types": ["node"],
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable",
        ],
    }},
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@playwright/test",
        "//:node_modules/@types/node",
        "//:node_modules/playwright",
    ],
)

js_library(
    name = "files",
    srcs = [
        "arguments.js",
        "baselines.js",
        "browser-runtime.js",
        "capture.js",
        "config.js",
        "config-url.js",
        "isolation.js",
        "host-browser.js",
        "matching.js",
        "network.js",
        "relocation.js",
        "remote-job.js",
        "vrt-processes.cjs",
        "package.json",
        "server.js",
        "static-server.js",
        "suite-config.js",
        "versions.js",
        "visuals.js",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runner_entry",
    srcs = ["runner.js"],
    visibility = ["//visibility:public"],
)

