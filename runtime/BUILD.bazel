load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//playwright:defs.bzl", "playwright_runtime")

ts_project(
    name = "typecheck",
    srcs = glob([
        "*.ts",
        "fixtures/*.ts",
    ]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "declaration": True,
        "skipLibCheck": True,
        "types": ["node"],
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable",
        ],
    }},
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@playwright/test",
        "//:node_modules/@types/node",
        "//:node_modules/playwright",
        "//:node_modules/testcontainers",
    ],
)

js_library(
    name = "files",
    srcs = [
        "arguments.js",
        "baselines.js",
        "capture.js",
        "config.js",
        "container.js",
        "isolation.js",
        "matching.js",
        "network.js",
        "package.json",
        "relay.js",
        "server.js",
        "static-server.js",
        "suite-config.js",
        "versions.js",
        "visuals.js",
    ],
    visibility = ["//visibility:public"],
    deps = ["//:node_modules/testcontainers"],
)

filegroup(
    name = "runner_entry",
    srcs = ["runner.js"],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "package",
    srcs = [
        "config.d.ts",
        "config.js",
        "matching.d.ts",
        "matching.js",
        "network.d.ts",
        "network.js",
        "package.json",
        "server-types.d.ts",
        "server-types.js",
        "static-server.d.ts",
        "static-server.js",
        "visuals.d.ts",
        "visuals.js",
    ],
    package = "@rules-web-e2e/vrt",
    visibility = ["//visibility:public"],
)

