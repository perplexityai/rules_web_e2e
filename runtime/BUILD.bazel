load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")

exports_files(["runner.mjs"])

js_library(
    name = "files",
    srcs = ["baselines.mjs"],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "package",
    srcs = [
        "browser-channel.mjs",
        "config.mjs",
        "package.json",
    ],
    package = "@rules-web-e2e/vrt",
    visibility = ["//visibility:public"],
)

js_test(
    name = "baselines_test",
    size = "small",
    data = ["baselines.mjs"],
    entry_point = "baselines.test.mjs",
)

copy_file(
    name = "runner_entry",
    src = "runner.mjs",
    out = "runner_entry.mjs",
    visibility = ["//visibility:public"],
)
