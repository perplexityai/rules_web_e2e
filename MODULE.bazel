module(
    name = "rules_web_e2e",
    version = "0.0.0",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "rules_web_e2e_npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "rules_web_e2e_npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
typescript.deps(ts_version = "7.0.2")
use_repo(typescript, "npm_typescript")

# Only consumers of the Linux preset download these locked package archives.
linux_presets = use_extension("//playwright:presets.bzl", "linux_presets")
use_repo(linux_presets, "rules_web_e2e_noble_20260901")

runtime_tools = use_extension("@bazel_lib//lib:extensions.bzl", "toolchains")
use_repo(runtime_tools, "zstd_toolchains")

# Used only by worker setup; ordinary browser targets do not fetch this archive.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "rules_web_e2e_actiond_source",
    downloaded_file_path = "actiond.tar.gz",
    sha256 = "efef39fc1d4888a8225eaca9f0663842ba60c256be8124265d917cd305226dc5",
    urls = ["https://github.com/hermeticbuild/actiond/archive/4b767e852e21c5affa72ea7ebbf4d8a6e5d58136.tar.gz"],
)
