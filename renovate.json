{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "automerge": false,
  "prConcurrentLimit": 5,
  "enabledManagers": ["npm", "bazel", "bazel-module", "bazelisk", "github-actions", "custom.regex"],
  "ignorePaths": ["**/node_modules/**", "**/bazel-*/**", "playwright/presets/*.json", "worker/linux_amd64.json"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)MODULE\\.bazel$/"],
      "matchStrings": ["typescript\\.deps\\(ts_version\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\)"],
      "depNameTemplate": "typescript",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep npm TypeScript and Bazel compiler versions together",
      "matchPackageNames": ["typescript"],
      "groupName": "TypeScript"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "matchPackageNames": ["@commitlint/cli", "@commitlint/types"],
      "groupName": "commitlint"
    },
    {
      "matchManagers": ["bazelisk"],
      "groupName": "Bazel"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Playwright upgrades require a matching new browser preset and default runtime version",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core"],
      "enabled": false
    },
    {
      "description": "Patched source archives and BCR overlays must be upgraded together",
      "matchFileNames": ["internal/test_tools/repositories.bzl"],
      "enabled": false
    },
    {
      "description": "Local consumers use the current checkout, not registry releases",
      "matchManagers": ["bazel-module"],
      "matchPackageNames": ["rules_web_e2e"],
      "enabled": false
    },
    {
      "description": "BCR provenance requires version tags on reusable release workflows",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["bazel-contrib/.github", "bazel-contrib/publish-to-bcr"],
      "pinDigests": false
    }
  ]
}
