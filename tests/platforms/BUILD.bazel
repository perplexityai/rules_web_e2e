load("//component:defs.bzl", "browser_shell", "component_browser_test")
load("//playwright:defs.bzl", "browser_runtime")
load("//vrt:defs.bzl", "component_visual_test", "visual_test")
load(":defs.bzl", "capture_test", "directory", "failure_test", "harness_selection_test", "native_visual_test", "properties_test", "runtime_inputs_test", "typed_fixture")

directory(
    name = "files",
    tags = ["manual"],
)

typed_fixture(name = "typed_fixture")

component_browser_test(
    name = "typed_browser",
    shell = ":shell",
    tests = ":typed_fixture",
    tags = ["manual"],
)

runtime_inputs_test(
    name = "runtime_inputs_test",
    target_under_test = ":typed_browser_inputs",
)

browser_shell(
    name = "shell",
    assets = ":files",
)

[
    browser_runtime(
        name = arch + "_browser",
        arch = arch,
        executable = "chrome",
        fontconfig = "fonts",
        library_dirs = ["lib"],
        loader = loader,
        node = "node",
        root = ":files",
    )
    for arch, loader in [
        ("x64", "ld-linux-x86-64.so.2"),
        ("arm64", "ld-linux-aarch64.so.1"),
    ]
]

[
    component_visual_test(
        name = arch,
        browser = ":" + arch + "_browser",
        shell = ":shell",
        target_arch = arch,
    )
    for arch in [
        "x64",
        "arm64",
    ]
]

capture_test(
    name = "arm64_test",
    loader = "ld-linux-aarch64.so.1",
    target_under_test = ":arm64_capture",
)

capture_test(
    name = "x64_test",
    loader = "ld-linux-x86-64.so.2",
    target_under_test = ":x64_capture",
)

component_visual_test(
    name = "wrong_runtime",
    browser = ":arm64_browser",
    shell = ":shell",
)

failure_test(
    name = "wrong_runtime_test",
    message = "browser runtime arch must match target_arch",
    target_under_test = ":wrong_runtime_capture",
)

component_visual_test(
    name = "wrong_platform",
    browser = ":arm64_browser",
    shell = ":shell",
    target_arch = "arm64",
    target_platform = "//internal:linux_amd64",
)

failure_test(
    name = "wrong_platform_test",
    message = "target_platform CPU must match target_arch",
    target_under_test = ":wrong_platform_capture",
)

component_visual_test(
    name = "custom_worker",
    browser = ":x64_browser",
    shell = ":shell",
    worker_sha256 = "a" * 64,
)

properties_test(
    name = "custom_worker_test",
    target_under_test = ":custom_worker_capture",
    worker_sha256 = "a" * 64,
)

properties_test(
    name = "compare_worker_test",
    target_under_test = ":x64",
)

properties_test(
    name = "inputs_without_worker_test",
    target_under_test = ":x64_inputs",
    worker_sha256 = "",
)

properties_test(
    name = "runtime_without_worker_test",
    target_under_test = ":x64_browser",
    worker_sha256 = "",
)

genrule(
    name = "spec",
    outs = ["fixture.browser.spec.js"],
    cmd = "touch $@",
)

component_browser_test(
    name = "native_browser",
    browser = ":x64_browser",
    shell = ":shell",
    tests = ":spec",
)

properties_test(
    name = "native_worker_test",
    target_under_test = ":native_browser",
)

properties_test(
    name = "capture_worker_test",
    target_under_test = ":x64_capture",
)

properties_test(
    name = "arm64_without_preset_test",
    target_under_test = ":arm64_capture",
    worker_sha256 = "",
)

visual_test(
    name = "native_visual_fixture",
    browser = ":x64_browser",
    shell = ":shell",
    tests = ":typed_fixture",
)

[
    harness_selection_test(
        name = name + "_harness_selection_test",
        target_under_test = target,
        gallery = gallery,
    )
    for name, target, gallery in [
        ("gallery", ":x64_inputs", True),
        ("component", ":typed_browser_inputs", False),
        ("visual_spec", ":native_visual_fixture_inputs", False),
    ]
]

native_visual_test(
    name = "native_visual_contract_test",
    target_under_test = ":x64",
)

native_visual_test(
    name = "arm64_native_visual_contract_test",
    target_under_test = ":arm64",
)
