load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//e2e:defs.bzl", "browser_process_test")
load("//tests:execution_tags_test.bzl", "selection_policy_test")

ts_project(
    name = "compiled",
    srcs = ["owned.spec.ts", "process.config.ts"],
    data = ["package.json"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "declaration": True,
        "skipLibCheck": True,
        "types": ["node"],
    }},
    deps = ["//:node_modules/@playwright/test", "//:node_modules/@types/node"],
)

browser_process_test(
    name = "owned_test",
    tests = ":compiled",
    config = ":process.config.js",
    data = [":compiled", "//tests/process/tool:echo.ts"],
    env = {
        "OWNED_PROCESS_VALUE": "declared",
        "OWNED_PROCESS_TOOL": "$(rootpath //tests/process/tool:echo.ts)",
    },
)

selection_policy_test(
    name = "default_selection_test",
    target = "owned_test",
)

browser_process_test(
    name = "without_config_test",
    tests = ":compiled",
    data = [":compiled", "//tests/process/tool:echo.ts"],
    env = {
        "OWNED_DEFAULT_CONFIG": "1",
        "OWNED_PROCESS_VALUE": "declared",
        "OWNED_PROCESS_TOOL": "$(rootpath //tests/process/tool:echo.ts)",
    },
)

ts_project(
    name = "timeout_compiled",
    srcs = ["timeout.spec.ts"],
    data = ["package.json"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "declaration": True,
        "skipLibCheck": True,
        "types": ["node"],
    }},
    deps = ["//:node_modules/@playwright/test", "//:node_modules/@types/node"],
)

browser_process_test(
    name = "timeout_contract_test",
    tests = ":timeout_compiled",
    data = [":timeout_compiled"],
    execution_timeout_seconds = 1,
    timeout = "short",
)
