load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//e2e:defs.bzl", "web_e2e_test", "web_e2e_ui")

ts_project(
    name = "compiled",
    srcs = [
        "aggregate.config.ts",
        "auth.spec.ts",
        "billing.spec.ts",
        "expected-base-url.ts",
        "ui.config.ts",
        "unused.spec.ts",
    ],
    data = ["package.json"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": True,
        "types": ["node"],
        "declaration": True,
        "sourceMap": True,
        "skipLibCheck": True,
    }},
    deps = [
        "//:node_modules/@playwright/test",
        "//:node_modules/@types/node",
    ],
)

js_library(
    name = "config",
    srcs = ["ui.config.js"],
    deps = [":compiled"],
)

[
    js_library(
        name = feature + "_specs",
        srcs = [feature + ".spec.js"],
        deps = [":compiled"],
    )
    for feature in [
        "auth",
        "billing",
    ]
]

[
    web_e2e_test(
        name = feature + "_test",
        config = ":config",
        tags = ["manual"],
        tests = ":" + feature + "_specs",
    )
    for feature in [
        "auth",
        "billing",
    ]
]

web_e2e_ui(
    name = "aggregate",
    config = ":config",
    suites = [
        ":auth_test",
        ":billing_test",
        ":auth_test",
    ],
)

test_suite(
    name = "auth_suite",
    tags = ["manual"],
    tests = [":auth_test"],
)

test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [
        ":auth_suite",
        ":billing_test",
    ],
)

web_e2e_ui(
    name = "suite_aggregate",
    config = ":aggregate_config",
    data = ["package.json"],
    env = {"UI_FIXTURE_PACKAGE": "$(rootpath package.json)"},
    suites = [
        ":all_tests",
        ":auth_test",
    ],
)

sh_test(
    name = "discovery_test",
    size = "small",
    srcs = ["discovery_test.sh"],
    args = ["$(rootpath :aggregate)"],
    data = [":aggregate"],
)

sh_test(
    name = "suite_discovery_test",
    size = "small",
    srcs = ["discovery_test.sh"],
    args = ["$(rootpath :suite_aggregate)"],
    data = [":suite_aggregate"],
)

js_library(
    name = "aggregate_config",
    srcs = ["aggregate.config.js"],
    deps = [":compiled"],
)

filegroup(
    name = "suite_bundle",
    testonly = True,
    srcs = [":suite_aggregate_ui_inputs"],
    output_group = "ui_bundle",
)

js_test(
    name = "bundle_test",
    size = "small",
    data = [
        ":suite_aggregate",
        ":suite_bundle",
    ],
    entry_point = "bundle_test.mjs",
    env = {"UI_BUNDLE": "$(rootpath :suite_bundle)"},
    patch_node_fs = False,
)

js_test(
    name = "headless_startup_test",
    size = "small",
    data = [":suite_aggregate"],
    entry_point = "headless_startup_test.mjs",
    env = {"UI_LAUNCHER": "$(rootpath :suite_aggregate)"},
    patch_node_fs = False,
    target_compatible_with = ["@platforms//os:linux"],
)
