load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@tar.bzl//tar:tar.bzl", "tar")
load("//tools:typescript.bzl", "tool_sources")
load(":archive.bzl", "browser_runtime_archive")
load(":layout_test.bzl", "layout_tests")
load(":test_tools.bzl", "bsd_tar", "coreutils")

layout_tests(name = "layout_tests")

coreutils(name = "coreutils", testonly = True)
bsd_tar(name = "bsd_tar", testonly = True)

tar(
    name = "archive_fixture",
    testonly = True,
    srcs = ["package.json"],
    compress = "xz",
)

browser_runtime_archive(
    name = "assembled_fixture",
    testonly = True,
    archive = ":archive_fixture",
    paths = {"playwright/package.json": "metadata.json"},
    files = {"package.json": "extra.json"},
)

exports_files(["defs.bzl", "archive.bzl", "copy_layout.sh"])

tool_sources(deps = ["//tools:typecheck", "//runtime:versions", "//:node_modules/tar"])

[
    js_binary(
        patch_node_fs = False,
        name = name,
        entry_point = name + ".js",
        data = [":typecheck", "package.json"],
        visibility = ["//visibility:public"],
    )
    for name in ["unpack_runtime", "browser_files", "validate_packages"]
]

[
    js_test(
        patch_node_fs = False,
        name = name + "_test",
        size = "small",
        entry_point = name + "_test.js",
        data = [":test_typecheck", "package.json"] + test_data,
        args = ["$(rootpath %s)" % label for label in test_data],
        no_copy_to_bin = [label for label in test_data if label.startswith(":")],
    )
    for name, test_data in [
        ("unpack_runtime", [":bsd_tar", ":assembled_fixture"]),
        ("browser_files", [":coreutils", "copy_layout.sh"]),
        ("validate_packages", []),
    ]
]

js_library(
    name = "preset_runtime_test_files",
    testonly = True,
    srcs = ["preset_runtime_test.js", "package.json"],
    visibility = ["//visibility:public"],
)
