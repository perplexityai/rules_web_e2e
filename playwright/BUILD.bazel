load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("//tools:typescript.bzl", "tool_sources")
load(":test_tools.bzl", "coreutils")

coreutils(name = "coreutils", testonly = True)

exports_files(["defs.bzl", "archive.bzl", "copy_layout.sh"])

tool_sources(deps = ["//tools:typecheck", "//runtime:typecheck", "//:node_modules/tar", "//:node_modules/seek-bzip"])

[
    js_binary(
        patch_node_fs = False,
        name = name,
        entry_point = name + ".js",
        data = [":typecheck", "package.json"],
        visibility = ["//visibility:public"],
    )
    for name in ["unpack_runtime", "browser_files", "validate_packages"]
]

[
    js_test(
        patch_node_fs = False,
        name = name + "_test",
        size = "small",
        entry_point = name + "_test.js",
        data = [":typecheck", "package.json"] + ([":coreutils", "copy_layout.sh"] if name == "browser_files" else []),
        args = ["$(rootpath :coreutils)", "$(rootpath copy_layout.sh)"] if name == "browser_files" else [],
        no_copy_to_bin = [":coreutils"] if name == "browser_files" else [],
    )
    for name in ["unpack_runtime", "browser_files", "validate_packages"]
]

js_library(
    name = "preset_runtime_test_files",
    srcs = ["preset_runtime_test.js", "package.json"],
    visibility = ["//visibility:public"],
)
