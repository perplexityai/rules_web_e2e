module(name = "browser_runtime_example")

bazel_dep(name = "rules_web_e2e", version = "0.0.0")
local_path_override(
    module_name = "rules_web_e2e",
    path = "../..",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "chromium",
    build_file_content = 'filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "a9da028861a0cf789ff25c2fed45f5f1aaf969ed9247835b6a7821a4f7af9d1d",
    strip_prefix = "chrome-headless-shell-linux64",
    urls = ["https://storage.googleapis.com/chrome-for-testing-public/153.0.8010.12/linux64/chrome-headless-shell-linux64.zip"],
)

http_archive(
    name = "node",
    build_file_content = 'exports_files(["bin/node"])',
    sha256 = "41cd79bb7877c81605a9e68ec4c91547774f46a40c67a17e34d7179ef11729df",
    strip_prefix = "node-v24.14.0-linux-x64",
    urls = ["https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-x64.tar.xz"],
)

http_archive(
    name = "chromium_arm64",
    build_file_content = 'filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "d433c45172c7836e38124fe545f767b02210bfb43a6262f08a297473a8e91c99",
    strip_prefix = "chrome-headless-shell-linux-arm64",
    urls = ["https://cdn.playwright.dev/builds/cft/153.0.8010.12/linux-arm64/chrome-headless-shell-linux-arm64.zip"],
)

http_archive(
    name = "node_arm64",
    build_file_content = 'exports_files(["bin/node"])',
    sha256 = "e7adfca03d9173276114a6f2219df1a7d25e1bfd6bbd771d3f839118a2053094",
    strip_prefix = "node-v24.14.0-linux-arm64",
    urls = ["https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-arm64.tar.xz"],
)

# Experimental local namespace test. Reuse upstream Bazel builds for the runner.
bazel_dep(name = "bubblewrap", version = "0.13.0.bcr.1")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")

http_archive(
    name = "probe_playwright",
    urls = ["https://registry.npmjs.org/playwright-core/-/playwright-core-1.63.0.tgz"],
    sha256 = "208593d4e1bcd8f8fe5f869cad1cc332dc7f1d70dc1d58c102dc3ac36e30f26c",
    strip_prefix = "package",
    build_file_content = 'exports_files(["package.json"])\nfilegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
)
