load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_web_e2e//component:defs.bzl", "browser_shell", "component_browser_test")
load("@rules_web_e2e//e2e:defs.bzl", "web_e2e_test")
load("@rules_web_e2e//playwright:defs.bzl", "playwright_runtime")
load("@rules_web_e2e//vrt:defs.bzl", "component_visual_test")

npm_link_all_packages(name = "node_modules")

npm_link_package(
    name = "node_modules/@rules-web-e2e/vrt",
    src = "@rules_web_e2e//runtime:package",
)

VRT_DEPS = [
    ":node_modules/@rules-web-e2e/vrt",
    ":node_modules/@vitejs/plugin-react",
    ":node_modules/@playwright/test",
    ":node_modules/playwright",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/vite",
]

ts_project(
    name = "typecheck_project",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
        ],
        exclude = ["remote-harness.ts"],
    ),
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = VRT_DEPS + [
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
    ],
)

filegroup(
    name = "typecheck",
    srcs = [":typecheck_project"],
    output_group = "transitive_typecheck",
)

js_library(
    name = "bundle_sources",
    srcs = glob([
        "*.tsx",
        "*.html",
    ]) + ["package.json"],
    deps = VRT_DEPS,
)

js_binary(
    name = "build_shell",
    data = [
        ":bundle_sources",
        ":typecheck",
        ":typecheck_project",
    ],
    entry_point = "build-shell.js",
)

js_run_binary(
    name = "bundle",
    args = ["assets"],
    out_dirs = ["assets"],
    tool = ":build_shell",
)

browser_shell(
    name = "app_shell",
    assets = ":bundle",
)

browser_shell(
    name = "component_shell",
    assets = ":bundle",
    entry_point = "gallery.html",
)

playwright_runtime(
    name = "playwright",
    core = ":node_modules/playwright-core/dir",
    test = ":node_modules/@playwright/test/dir",
)

js_library(
    name = "e2e_specs",
    srcs = [
        "card.spec.js",
        "isolation.spec.js",
    ],
    deps = [":typecheck_project"],
)

js_library(
    name = "component_specs",
    srcs = ["counter.browser.spec.js"],
    deps = [":typecheck_project"],
)

js_library(
    name = "remote_specs",
    srcs = ["remote.spec.js"],
    deps = [":typecheck_project"],
)

component_visual_test(
    name = "visual_test",
    baselines = glob(
        ["__screenshots__/*.png"],
        allow_empty = True,
    ),
    matching = ":matching",
    shell = ":app_shell",
)

component_visual_test(
    name = "component_visual_test",
    baseline_dir = "__component_screenshots__",
    baselines = glob(
        ["__component_screenshots__/*.png"],
        allow_empty = True,
    ),
    matching = ":matching",
    shell = ":component_shell",
)

component_browser_test(
    name = "component_test",
    playwright = ":playwright",
    shell = ":component_shell",
    tests = ":component_specs",
)

web_e2e_test(
    name = "e2e_test",
    shell = ":app_shell",
    tests = ":e2e_specs",
)

web_e2e_test(
    name = "remote_test",
    base_url_env = "EXAMPLE_REMOTE_URL",
    env_inherit = ["EXAMPLE_BLOCKED_URL"],
    tests = ":remote_specs",
)

ts_project(
    name = "remote_harness",
    srcs = ["remote-harness.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": True,
        "skipLibCheck": True,
    }},
    deps = [":node_modules/@types/node"],
)

js_test(
    name = "remote_integration_test",
    copy_data_to_bin = False,
    data = [
        "package.json",
        ":remote_test",
    ],
    entry_point = "remote-harness.js",
    env = {"REMOTE_TEST": "$(rlocationpath :remote_test)"},
    env_inherit = [
        "DOCKER_HOST",
        "DOCKER_CONTEXT",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
    ],
    tags = [
        "external",
        "manual",
        "no-cache",
        "no-remote",
        "no-sandbox",
        "requires-network",
    ],
)

js_library(
    name = "matching",
    srcs = ["matching.js"],
    data = ["package.json"],
)
