{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom", "@vitest/browser-playwright"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["*.ts", "*.tsx"]
}
