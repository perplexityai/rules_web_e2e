load(":defs.bzl", "local_tools")

exports_files(["launcher.sh.tpl"])

[
    local_tools(
        name = "tools" + suffix,
        target_arch = arch,
        tags = ["manual"],
        # The browser macro attaches this dependency to targets in consumer repositories.
        visibility = ["//visibility:public"],
    )
    for arch, suffix in [("x64", ""), ("arm64", "_arm64")]
]
