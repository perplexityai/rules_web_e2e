load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//tools:typescript.bzl", "tool_sources")

tool_sources(deps = ["//:node_modules/@bazel/runfiles", "//:node_modules/fflate"])
load(":defs.bzl", "runfiles_tools", "test_tools")

[
    test_tools(
        name = "tools" if arch == "x64" else "tools_arm64",
        target_arch = arch,
        file = "@test_tools_libmagic//:file",
        magic = "@test_tools_libmagic//:magic.mgc",
        toybox = "@test_tools_toybox//:toybox",
        visibility = ["//:__subpackages__"],
        zip = "@zip//:zip",
    )
    for arch in ["x64", "arm64"]
]

js_test(
    patch_node_fs = False,
    name = "tools_test",
    size = "small",
    entry_point = "tools_test.js",
    args = ["$(rlocationpaths :tools)"],
    data = [":tools", ":typecheck", "package.json"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],

)

[
    js_test(
        patch_node_fs = False,
        name = "elf_" + arch + "_test",
        size = "small",
        entry_point = "elf_test.js",
        args = [str(machine), "$(rlocationpaths " + tools + ")"],
        data = [tools, ":typecheck", "package.json"],

    )
    for arch, machine, tools in [("x64", 62, ":tools"), ("arm64", 183, ":tools_arm64")]
]

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

[
    runfiles_tools(
        name = "runfiles_tools" if arch == "x64" else "runfiles_tools_arm64",
        target_arch = arch,
        toybox = "@test_tools_toybox//:toybox",
        visibility = ["//:__subpackages__"],
    )
    for arch in ["x64", "arm64"]
]
