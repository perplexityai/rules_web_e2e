module(name = "actiond_browser_runtime")

bazel_dep(name = "rules_web_e2e", version = "0.0.0")
local_path_override(
    module_name = "rules_web_e2e",
    path = "../../..",
)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_distroless", version = "0.9.4")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = [
        "main",
        "universe",
    ],
    suites = [
        "noble",
        "noble-updates",
        "noble-security",
    ],
    types = ["deb"],
    uris = ["https://snapshot.ubuntu.com/ubuntu/20260901T000000Z"],
)
apt.install(
    dependency_set = "vrt_noble",
    packages = [
        "bash:amd64",
        "ca-certificates:amd64",
        "coreutils:amd64",
        "fontconfig:amd64",
        "fonts-freefont-ttf:amd64",
        "fonts-ipafont-gothic:amd64",
        "fonts-liberation:amd64",
        "fonts-noto-color-emoji:amd64",
        "fonts-tlwg-loma-otf:amd64",
        "fonts-unifont:amd64",
        "fonts-wqy-zenhei:amd64",
        "libasound2t64:amd64",
        "libatk-bridge2.0-0t64:amd64",
        "libatk1.0-0t64:amd64",
        "libatspi2.0-0t64:amd64",
        "libcairo2:amd64",
        "libcups2t64:amd64",
        "libdbus-1-3:amd64",
        "libdrm2:amd64",
        "libfontconfig1:amd64",
        "libfreetype6:amd64",
        "libgbm1:amd64",
        "libglib2.0-0t64:amd64",
        "libnspr4:amd64",
        "libnss3:amd64",
        "libpango-1.0-0:amd64",
        "libstdc++6:amd64",
        "libudev1:amd64",
        "libx11-6:amd64",
        "libxcb1:amd64",
        "libxcomposite1:amd64",
        "libxdamage1:amd64",
        "libxext6:amd64",
        "libxfixes3:amd64",
        "libxkbcommon0:amd64",
        "libxrandr2:amd64",
        "tzdata:amd64",
        "xfonts-cyrillic:amd64",
        "xfonts-scalable:amd64",
    ],
    suites = [
        "noble",
        "noble-updates",
        "noble-security",
    ],
)
use_repo(apt, "vrt_noble")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "chromium",
    build_file_content = 'filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "a9da028861a0cf789ff25c2fed45f5f1aaf969ed9247835b6a7821a4f7af9d1d",
    strip_prefix = "chrome-headless-shell-linux64",
    urls = ["https://storage.googleapis.com/chrome-for-testing-public/153.0.8010.12/linux64/chrome-headless-shell-linux64.zip"],
)

http_archive(
    name = "node",
    build_file_content = 'exports_files(["bin/node"])',
    sha256 = "41cd79bb7877c81605a9e68ec4c91547774f46a40c67a17e34d7179ef11729df",
    strip_prefix = "node-v24.14.0-linux-x64",
    urls = ["https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-x64.tar.xz"],
)
