load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_web_e2e//playwright:archive.bzl", "browser_runtime_archive")

copy_to_directory(
    name = "chromium",
    srcs = ["@chromium//:files"],
    include_external_repositories = ["*"],
)

browser_runtime_archive(
    name = "files",
    archives = ["@vrt_noble//:packages"],
    # Preserve the established Liberation font policy; DejaVu is an APT alternative.
    exclude = [
        "usr/share/fonts/truetype/dejavu",
        "etc/fonts/conf.d/20-unhint-small-dejavu-lgc-sans-mono.conf",
        "etc/fonts/conf.d/20-unhint-small-dejavu-lgc-sans.conf",
        "etc/fonts/conf.d/20-unhint-small-dejavu-lgc-serif.conf",
        "etc/fonts/conf.d/20-unhint-small-dejavu-sans-mono.conf",
        "etc/fonts/conf.d/20-unhint-small-dejavu-sans.conf",
        "etc/fonts/conf.d/20-unhint-small-dejavu-serif.conf",
        "etc/fonts/conf.d/57-dejavu-sans-mono.conf",
        "etc/fonts/conf.d/57-dejavu-sans.conf",
        "etc/fonts/conf.d/57-dejavu-serif.conf",
        "etc/fonts/conf.d/58-dejavu-lgc-sans-mono.conf",
        "etc/fonts/conf.d/58-dejavu-lgc-sans.conf",
        "etc/fonts/conf.d/58-dejavu-lgc-serif.conf",
    ],
    files = {
        ":fonts.conf": "etc/fonts/fonts.conf",
        ":chromium": "chromium",
        "@node//:bin/node": "bin/node",
    },
    paths = {
        "etc/fonts/conf.d": "etc/fonts/conf.d",
        "usr/bin/bash": "bin/bash",
        "usr/bin/env": "bin/env",
        "usr/bin/dirname": "bin/dirname",
        "usr/bin/uname": "bin/uname",
        "usr/bin/readlink": "bin/readlink",
        "usr/lib/x86_64-linux-gnu": "lib",
        "usr/share/fonts": "fonts",
    },
)
