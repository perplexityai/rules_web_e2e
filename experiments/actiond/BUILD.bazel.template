load(":capture.bzl", "capture", "kernel_probe")

platform(
    name = "linux_amd64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

capture(
    name = "capture",
    node = "runtime/bin/node",
    script = "capture.mjs",
    runtime = ["ld.so"] + glob(["runtime/**"]),
    playwright = glob(["playwright-core/**"]),
)

kernel_probe(
    name = "kernel_probe",
    binary = "kernel-probe",
)
